{
  "steps": [
    {"actions": [
      {"do": "create", "slot": "a", "object": {"apiVersion": "toy.reconciler-fuzzer/v1", "kind": "Cluster", "metadata": {"name": "cluster"}, "spec": {"volumes": 2, "volumeSize": "small"}}},
      {"do": "create", "slot": "b", "object": {"apiVersion": "toy.reconciler-fuzzer/v1", "kind": "Database", "metadata": {"name": "db"}, "spec": {"clusterRef": "cluster", "engine": "postgres", "passwordSecretRef": {"name": "admin-password"}}}}
    ]},
    {"period": "3s", "actions": [
      {"do": "kill"},
      {"at": "1s", "do": "changeFixture", "target": {"resource": "secrets", "name": "admin-password"}}
    ]}
  ]
}
