{
  "steps": [
    {"actions": [
      {"do": "changeFixture", "target": {"resource": "secrets", "name": "admin-password"}},
      {"do": "create", "slot": "a", "object": {"apiVersion": "toy.reconciler-fuzzer/v1", "kind": "Cluster", "metadata": {"name": "cluster"}, "spec": {"volumes": 2, "volumeSize": "small"}}}
    ]},
    {
      "period": "2.8s",
      "faults": [{"match": {"verb": "update", "group": "toy.reconciler-fuzzer", "resource": "databases"}, "error": {"code": 500}}],
      "actions": [{"do": "create", "slot": "b", "object": {"apiVersion": "toy.reconciler-fuzzer/v1", "kind": "Database", "metadata": {"name": "db"}, "spec": {"clusterRef": "cluster", "engine": "postgres", "passwordSecretRef": {"name": "admin-password"}}}}]
    }
  ]
}
